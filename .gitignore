# =========================
# C/C++ 编译产物
# =========================
# 1. 编译产生的中间文件 (Object files)
*.o
*.obj
*.d

# 2. 库文件 (Libraries)
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll

# 3. 常见的可执行文件后缀 (虽然 Linux 不一定用，但防万一)
*.exe
*.out
*.app

# =========================
# 临时文件与系统文件
# =========================
# 常见的临时文件
*.tmp
*.log
*.swp
*~
.DS_Store

# Core dumps (程序崩溃时的内存转储，通常很大，必须忽略)
core
core.*

# =========================
# IDE / 编辑器配置
# =========================
# VS Code (通常个人配置不需要上传，保留 launch.json 方便调试可例外)
.vscode/

# CMake 构建目录 (如果你以后用 CMake)
build/
cmake-build-debug/
cmake-build-release/

